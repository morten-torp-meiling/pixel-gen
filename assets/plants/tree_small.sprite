# Small tree, top-down 3/4 view, light from the top left. 32x48, anchor at the trunk base.
# The canopy is a cluster of rounded clumps; the outline is added automatically.
sprite tree_small
size 32 48
palette farm
anchor 16 47

part canopy
  ................................
  ............LLLLLLLg............
  ...........LLLLLLLggg...........
  ..........LLLLLLgggggg..........
  .........LLLLLLgggggggg.........
  .........LLLLLggggggggg.........
  ........LLLLggggggggggGL........
  .....LLLLLLgggggggggLLLLLLg.....
  ....LLLLLLgglllLLLLLLLLLLggg....
  ...LLLLLgggllLLLLLgggLLgggggg...
  ..LLLLLgggllLLLLLggggggggggggg..
  ..LLLLgggllLLLLLgggggggggggggG..
  ..LLgggglLLLLLggggggggggggggGG..
  ..LgggggLLLLLgggggggggggGggGGG..
  ..ggggggLLLLgggggggggggGGGGGGG..
  ..gggLLLLLggggggggggggGGgLgGGF..
  ...gLLLLLgggggggggggGGGGGgggF...
  ...LLLLLgggggggggggGGGGGGgggg...
  ...LLLLgggggggggggGGGGGGGgggg...
  ...LLgggggggggggGGGGGGGFGgggG...
  ..LLggggGggggggGGGGGGFFGGggGGG..
  ...ggggggGggggGGGGGGFFGGggGGG...
  ...ggggggGFgGGGGGGGFFGGgGGGGG...
  ...gggggGGGFGGGGGFFFGGgGGGGFF...
  ....gggGGGGFFGGGGGFGGgGGGGFF....
  .....FFFFFFFFFGGGFFFFFFFFFF.....
  ........FFFFFGGFFFFFFFFF........
  ...........GGGFFFFFFF...........
  ................................
  ................................
end

# Trunk with a little root flare; its top is hidden under the canopy, and the
# first rows below the canopy are in its shade.
part trunk
  ..VwwwWW..
  ..VwwwWW..
  ..VwWwwW..
  ..VwwwWW..
  ..WWWWWW..
  ..WwwwWW..
  ..VwwwWW..
  ..VwwwWW..
  ..VWwwwW..
  ..VwwwWW..
  ..VwwwWW..
  ..VwwWwW..
  ..VwwwWW..
  ..VwwwWW..
  ..VwwwWW..
  .VVwwwwWW.
  .VwwwwwwW.
  VVwwwwwwWW
  VwwwwwwWWW
end

frame tree
  stamp trunk 11 27
  stamp canopy 0 3
end

outline K selective
shadow ~ 18 4
