# Ground for one TileMapLayer: grass, dirt and tilled soil, and every transition
# between grass and dirt. Light from the top left; grass stands slightly above dirt.
# Tilled soil is darker plain soil with broken furrows and a few lit ridge dashes.
#
# Atlas order (columns 4) reads like a dirt patch: corners and edges around dirt,
# inner corners on the right, then the base tiles and the second edge versions.
tileset ground
palette farm
columns 4

part grass_tex
  gggggggGLGgggggg
  gLgLggggggggGggg
  gGLGgggggggggggg
  ggggglgggLgLgggg
  gggggggggGLGgggg
  LgggggGgggggggLg
  GgggggggggggggGL
  ggggggggggggglgg
  ggggLgLggggggggg
  ggggGLGggggggggg
  lggggggggggLgLgg
  gggggggggggGLGgg
  gggggggggGgggggg
  ggLgLggggggggggg
  ggGLGgggggggggGg
  gggggggLgLgggggg
end
part dirt_tex
  dddddddddddddddd
  ddTdddddddDddddd
  dddddddddddddddd
  dddddDdddddddTdd
  dddddddddddddddd
  dTddddddddDddddd
  ddddddddTddddddd
  dddDdddddddddddD
  dddddddddddddddd
  ddddddddddddTddd
  ddddddTddddddddd
  dDdddddddddddddd
  ddddddddddDddddd
  dddddddddddddddT
  dddTdddddddddddd
  dddddddddddddddd
end
part tilled_tex
  ddTTddddddTTTddd
  dddddddddddddddd
  DDdDDDdDDDDdDDDd
  ddddDdddddddddDd
  TTdddddTTTdddddT
  dddddddddddddddd
  DDDdDDDDdDDDDdDD
  dDdddddddddDdddd
  dddTTTdddddddTTd
  dddddddddddddddd
  DdDDDDdDDDdDDDDD
  dddddDdddddddDdd
  dddddddTTTdddddd
  TTdddddddddddddd
  DDDDdDDDDdDDDdDD
  dddDdddddddDdddd
end

# Grass meeting dirt. Each profile is how many rows (n, s) or columns (w, e) of grass reach
# in from that side; all start and end at 5, so edges, corners and inner corners meet.
# The light: grass with dirt below or right of it is the bank G, grass with dirt above or
# left of it the lit lip L, and dirt just below or right of grass gets the shadow D.
terrain grass_dirt
  raised grass_tex
  lower dirt_tex
  bank G
  lip L
  shadow D
  n  5 5 6 6 6 5 5 4 4 5 6 6 5 5 5 5
  s  5 5 5 6 6 5 4 4 5 5 6 6 6 5 5 5
  w  5 5 6 6 5 5 4 4 5 6 6 6 5 5 5 5
  e  5 5 5 4 4 5 6 6 5 5 4 5 6 6 5 5
  # Second versions, so long edges don't repeat their wobble every tile.
  n2 5 5 4 4 5 6 6 6 5 5 4 4 5 6 6 5
  s2 5 6 6 5 5 4 4 5 6 6 5 5 4 4 5 5
  w2 5 4 4 5 6 6 5 5 4 4 5 6 6 5 5 5
  e2 5 6 6 6 5 4 4 5 5 6 6 5 4 4 5 5
end

# Outer corners combine two edges (|); inner corners are where both reach (&).
tile dirt_corner_nw wrap none
  blend grass_dirt n|w
end
tile dirt_edge_n wrap x
  blend grass_dirt n
end
tile dirt_corner_ne wrap none
  blend grass_dirt n|e
end
tile dirt_inner_nw wrap none
  blend grass_dirt n&w
end
tile dirt_edge_w wrap y
  blend grass_dirt w
end
tile dirt
  stamp dirt_tex 0 0
end
tile dirt_edge_e wrap y
  blend grass_dirt e
end
tile dirt_inner_ne wrap none
  blend grass_dirt n&e
end
tile dirt_corner_sw wrap none
  blend grass_dirt s|w
end
tile dirt_edge_s wrap x
  blend grass_dirt s
end
tile dirt_corner_se wrap none
  blend grass_dirt s|e
end
tile dirt_inner_sw wrap none
  blend grass_dirt s&w
end
tile grass
  stamp grass_tex 0 0
end
tile grass_b from grass flipx
# Grass with its clusters moved 9 px across and 6 down (wrapping), so it differs from both.
tile grass_c
  ggLgLgglgggggggg
  ggGLGggggggggggg
  Gggggggggggggggg
  gggggggggLgLgggg
  gggggGgggGLGgggg
  LgggggggggggggLg
  GgggggggggggggGL
  gggGggggLgLggggg
  ggggggggGLGggggg
  LgLggggggggglggg
  GLGggggggggggggg
  gggggLgLgggggGgg
  gggggGLGgggggggg
  gggglggggggggggg
  gggggggggggLgLgg
  gggggggggggGLGgg
end
tile dirt_inner_se wrap none
  blend grass_dirt s&e
end
tile dirt_edge_n_b wrap x
  blend grass_dirt n2
end
tile dirt_edge_s_b wrap x
  blend grass_dirt s2
end
tile dirt_edge_w_b wrap y
  blend grass_dirt w2
end
tile dirt_edge_e_b wrap y
  blend grass_dirt e2
end
tile dirt_b from dirt flipx
tile tilled
  stamp tilled_tex 0 0
end
