# A dirt patch in grass with every transition piece: four outer corners, a grass notch
# into the top and one into the bottom (all four inner corners), an arm reaching right,
# long edges mixing both versions, and a tilled bed. Check with:
#   pg mockup assets/tiles/ground.tileset assets/tiles/patch.mockup
g = grass grass_b grass_c
d = dirt dirt_b
t = tilled
1 = dirt_corner_nw
2 = dirt_corner_ne
3 = dirt_corner_sw
4 = dirt_corner_se
n = dirt_edge_n dirt_edge_n_b
s = dirt_edge_s dirt_edge_s_b
w = dirt_edge_w dirt_edge_w_b
e = dirt_edge_e dirt_edge_e_b
a = dirt_inner_nw
b = dirt_inner_ne
c = dirt_inner_sw
f = dirt_inner_se
map
  gggggggggggg
  g1n2gg1n2ggg
  gwdbnnadeggg
  gwddttddeggg
  gwddttddeggg
  gwddddddbn2g
  gwdfsscdddeg
  g3s4gg3sss4g
  gggggggggggg
